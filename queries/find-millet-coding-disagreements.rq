PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX review: <http://www.learn-graph.net/nanodidax/review/>
PREFIX bibo:   <http://purl.org/ontology/bibo/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?target ?page
       (COUNT(DISTINCT ?reviewer) AS ?reviewerCount)
       (COUNT(DISTINCT ?body) AS ?bodyCount)
       (GROUP_CONCAT(DISTINCT ?reviewerLabel; separator=" | ") AS ?reviewers)
       (GROUP_CONCAT(DISTINCT ?bodyValue; separator=" | ") AS ?assignedBodies)
WHERE {
  GRAPH ?graph {
    ?annotation a oa:Annotation ;
                oa:hasTarget ?target ;
                oa:hasBody ?body ;
                prov:wasAttributedTo ?reviewer ;
                prov:wasGeneratedBy ?activity .
    ?activity a review:IndependentCodingActivity .
    ?reviewer rdfs:label ?reviewerLabel .
    ?target bibo:pages ?page .

    OPTIONAL { ?body rdfs:label ?localBodyLabel }
  }

  OPTIONAL {
    ?body skos:prefLabel ?conceptLabel .
    FILTER(LANG(?conceptLabel) = "en")
  }

  BIND(COALESCE(?conceptLabel, ?localBodyLabel, STR(?body)) AS ?bodyValue)
}
GROUP BY ?target ?page
HAVING (
  COUNT(DISTINCT ?reviewer) > 1 &&
  COUNT(DISTINCT ?body) > 1
)
ORDER BY ?page
