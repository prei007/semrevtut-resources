PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX review: <http://www.learn-graph.net/nanodidax/review/>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?annotationLabel ?bodyValue
       (GROUP_CONCAT(DISTINCT ?reviewerLabel; separator=" | ") AS ?reviewers)
       ?generated ?manualVersion ?codebookVersion ?statusLabel
WHERE {
  GRAPH ?graph {
    ?annotation a oa:Annotation ;
                rdfs:label ?annotationLabel ;
                oa:hasBody ?body ;
                prov:wasAttributedTo ?reviewer ;
                prov:generatedAtTime ?generated ;
                review:usedCodingManualVersion ?manual ;
                review:hasStatus review:Accepted .

    ?reviewer rdfs:label ?reviewerLabel .
    ?manual dct:identifier ?manualVersion .
    review:Accepted skos:prefLabel ?statusLabel .

    OPTIONAL {
      ?annotation review:usedCodebookVersion ?codebook .
      ?codebook dct:identifier ?codebookVersion .
    }
    OPTIONAL { ?body rdfs:label ?localBodyLabel }
  }

  OPTIONAL {
    ?body skos:prefLabel ?conceptLabel .
    FILTER(LANG(?conceptLabel) = "en")
  }

  BIND(COALESCE(?conceptLabel, ?localBodyLabel, STR(?body)) AS ?bodyValue)
}
GROUP BY ?annotationLabel ?bodyValue ?generated ?manualVersion
         ?codebookVersion ?statusLabel
ORDER BY ?generated ?annotationLabel
