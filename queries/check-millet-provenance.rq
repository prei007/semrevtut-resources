PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX review: <http://www.learn-graph.net/nanodidax/review/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?annotationLabel ?missing
WHERE {
  {
    GRAPH ?graph {
      ?annotation a oa:Annotation ;
                  rdfs:label ?annotationLabel .

      VALUES (?requiredProperty ?missing) {
        (prov:wasAttributedTo                 "responsible agent")
        (prov:wasGeneratedBy                  "generating activity")
        (prov:generatedAtTime                 "generation time")
        (review:usedCodingManualVersion       "coding-manual version")
        (review:hasStatus                     "review status")
      }

      FILTER NOT EXISTS { ?annotation ?requiredProperty ?value }
    }
  }
  UNION
  {
    GRAPH ?graph {
      ?annotation a oa:Annotation ;
                  rdfs:label ?annotationLabel ;
                  oa:hasBody ?body .
      FILTER NOT EXISTS {
        ?annotation review:usedCodebookVersion ?codebookVersion
      }
    }
    ?body a skos:Concept .
    BIND("codebook version for a SKOS classification" AS ?missing)
  }
}
ORDER BY ?annotationLabel ?missing
