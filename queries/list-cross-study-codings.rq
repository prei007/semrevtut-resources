PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX review: <http://www.learn-graph.net/nanodidax/review/>
PREFIX meth:   <http://www.learn-graph.net/nanodidax/schemes/methods/>
PREFIX feat:   <http://www.learn-graph.net/nanodidax/schemes/features/>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?citation ?methodLabel ?technologyLabel
       ?methodReviewerLabel ?technologyReviewerLabel
       ?methodVersion ?technologyVersion
WHERE {
  GRAPH ?methodGraph {
    ?methodAnnotation a oa:Annotation ;
                      oa:hasBody ?method ;
                      oa:hasTarget/oa:hasSource ?publication ;
                      prov:wasAttributedTo ?methodReviewer ;
                      review:usedCodebookVersion ?methodCodebookVersion ;
                      review:hasStatus review:Accepted .

    ?publication rdfs:label ?citation .
    ?methodReviewer rdfs:label ?methodReviewerLabel .
    ?methodCodebookVersion dct:source meth:Methods ;
                           dct:identifier ?methodVersion .
  }

  ?method skos:inScheme meth:Methods ;
          skos:prefLabel ?methodLabel .
  FILTER(LANG(?methodLabel) = "en")

  GRAPH ?technologyGraph {
    ?technologyAnnotation a oa:Annotation ;
                          oa:hasBody ?technology ;
                          oa:hasTarget/oa:hasSource ?publication ;
                          prov:wasAttributedTo ?technologyReviewer ;
                          review:usedCodebookVersion ?technologyCodebookVersion ;
                          review:hasStatus review:Accepted .

    ?technologyReviewer rdfs:label ?technologyReviewerLabel .
    ?technologyCodebookVersion dct:source feat:Features ;
                               dct:identifier ?technologyVersion .
  }

  ?technology skos:inScheme feat:Features ;
              skos:prefLabel ?technologyLabel .
  FILTER(LANG(?technologyLabel) = "en")
}
ORDER BY ?citation
