PREFIX bloom: <http://www.learn-graph.net/thesauri/bloom_outcomes/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>

SELECT ?notation ?preferred
WHERE {
  ?concept skos:inScheme bloom:RevisedCognitiveProcessDimension ;
           skos:notation ?notation ;
           skos:prefLabel ?preferred .
  FILTER(LANG(?preferred) = "en")
}
ORDER BY ?notation
