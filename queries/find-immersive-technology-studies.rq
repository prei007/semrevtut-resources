PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX review: <http://www.learn-graph.net/nanodidax/review/>
PREFIX feat:   <http://www.learn-graph.net/nanodidax/schemes/features/>
PREFIX bibo:   <http://purl.org/ontology/bibo/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?citation ?technologyLabel ?page ?reviewerLabel
WHERE {
  GRAPH ?graph {
    ?annotation a oa:Annotation ;
                oa:hasBody ?technology ;
                oa:hasTarget ?target ;
                prov:wasAttributedTo ?reviewer ;
                review:hasStatus review:Accepted .

    ?target oa:hasSource ?publication ;
            bibo:pages ?page .
    ?publication rdfs:label ?citation .
    ?reviewer rdfs:label ?reviewerLabel .
  }

  ?technology skos:inScheme feat:Features ;
              skos:prefLabel ?technologyLabel ;
              skos:broader* feat:ImmersiveTech .
  FILTER(LANG(?technologyLabel) = "en")
}
ORDER BY ?citation ?technologyLabel
