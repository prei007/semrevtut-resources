  hsann:VideoGameSelector
      a oa:TextQuoteSelector ;
      oa:exact
          "Here, we report on the use of an interactive text-style video game, NanoAdventure, to communicate about sense of scale and nanotechnology to the public."@en .

  hsann:VideoGameAnnotation
      a oa:Annotation, prov:Entity ;
