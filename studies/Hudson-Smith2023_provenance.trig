      a oa:TextQuoteSelector ;
      oa:exact
          "NanoAdventure was launched in three languages (English, Spanish, Chinese) and compared to textbook-style and blog-style control texts in a randomized study."@en .

  hsann:RandomizedExperimentAnnotation
      a oa:Annotation, prov:Entity ;
