      oa:hasSelector hsann:KnowledgeGainSelector .

  hsann:KnowledgeGainSelector
      a oa:TextQuoteSelector ;
      oa:prefix
          "In the Blog group, all statements showed a statistically significant increase in knowledge."@en ;
      oa:exact
          "In the NanoAdventure Game group, three of five statements show a statistically significant increase in knowledge (Figure 8)."@en ;
      oa:suffix
          "The two questions that did not show significant improvement in the NanoAdventure condition were Question 4.1/23,"@en .

  hsann:KnowledgeGainAnnotation
      a oa:Annotation, prov:Entity ;
      rdfs:label "Extraction of the NanoAdventure knowledge finding"@en ;
      oa:motivatedBy oa:describing ;
      oa:hasBody hsann:KnowledgeGainClaim ;
