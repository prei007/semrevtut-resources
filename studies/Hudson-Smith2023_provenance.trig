      prov:generatedAtTime "2026-08-14T10:18:00+02:00"^^xsd:dateTime ;
      review:usedCodingManualVersion hsann:CodingManualVersion_0_1_0 ;
      review:hasStatus review:Accepted .


  #################################################################
  # Reviewer 1-only target 3: text-experience finding
  #################################################################

  hsann:EnjoymentClaim
      a mp:Claim ;
      rdfs:label "NanoAdventure was more enjoyable than the textbook"@en ;
      mp:statement
          "Participants rated NanoAdventure as more enjoyable and fun than the textbook condition."@en .

  hsann:EnjoymentData
