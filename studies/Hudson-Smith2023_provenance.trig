  #################################################################
  # Shared target 1: stated educational purpose
  #################################################################

  hsann:BloomUnderstandTarget
      a oa:SpecificResource ;
      oa:hasSource study:Hudson-Smith2023_Publication ;
      bibo:pages "2269" ;
      oa:hasSelector hsann:BloomUnderstandSelector .

  hsann:BloomUnderstandSelector
      a oa:TextQuoteSelector ;
      oa:prefix
          "However, the development of educational video games requires expertise and, frequently, a sizable budget."@en ;
      oa:exact
          "Here, we report on the use of an interactive text-style video game, NanoAdventure, to communicate about sense of scale and nanotechnology to the public."@en ;
      oa:suffix
          "NanoAdventure was developed on an open-source, free-to-use platform with simple coding and enhanced with free or low-cost assets."@en .

  # Reviewer 1 interprets the purpose as Understand.
  hsann:BloomUnderstandAnnotation
      a oa:Annotation, prov:Entity ;
      rdfs:label "Bloom Understand coding of NanoAdventure's stated purpose"@en ;
      oa:motivatedBy oa:classifying ;
      oa:hasBody bloom:RevisedUnderstand ;
      oa:hasTarget hsann:BloomUnderstandTarget ;
      dct:description
          "Reviewer memo: the passage describes communicating conceptual meaning about scale and nanotechnology; the classification concerns the intended cognitive process, not the occurrence of a particular verb."@en ;
      prov:wasAttributedTo hsann:Reviewer1 ;
      prov:wasGeneratedBy hsann:Reviewer1CodingSession ;
      prov:generatedAtTime "2026-08-14T09:12:00+02:00"^^xsd:dateTime ;
      review:usedCodingManualVersion hsann:CodingManualVersion_0_1_0 ;
      review:usedCodebookVersion hsann:BloomCodebookVersion_0_2_0 ;
      review:hasStatus review:Superseded .

  # Reviewer 2 applies Remember to the same passage: an explicit disagreement.
  hsann:BloomRememberAnnotation_R2
      a oa:Annotation, prov:Entity ;
      rdfs:label "Reviewer 2: Bloom Remember coding"@en ;
      oa:motivatedBy oa:classifying ;
      oa:hasBody bloom:RevisedRemember ;
      oa:hasTarget hsann:BloomUnderstandTarget ;
      dct:description
          "The stated public-communication goal was interpreted as recall of nanoscale information."@en ;
      prov:wasAttributedTo hsann:Reviewer2 ;
      prov:wasGeneratedBy hsann:Reviewer2CodingSession ;
      prov:generatedAtTime "2026-08-14T10:10:00+02:00"^^xsd:dateTime ;
      review:usedCodingManualVersion hsann:CodingManualVersion_0_1_0 ;
      review:usedCodebookVersion hsann:BloomCodebookVersion_0_2_0 ;
      review:hasStatus review:Superseded .


  #################################################################
  # Shared target 2: knowledge finding (agreement)
  #################################################################

  hsann:KnowledgeGainClaim
      a mp:Claim ;
      rdfs:label "Knowledge increased on three of five items"@en ;
      mp:statement
          "NanoAdventure participants showed statistically significant knowledge increases on three of five nanotechnology knowledge items."@en .

  hsann:KnowledgeGainData
      a mp:Data ;
      rdfs:label "Reported NanoAdventure knowledge-comparison result"@en ;
      dct:source hsann:KnowledgeGainTarget ;
