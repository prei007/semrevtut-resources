  #################################################################
  # Shared target 1: cognitive coding of activity A2
  #################################################################

  mlann:AnalogyLearningTarget
      a oa:SpecificResource ;
      oa:hasSource study:Millet2013_Publication ;
      bibo:pages "608" ;
      oa:hasSelector mlann:AnalogyLearningSelector .

  mlann:AnalogyLearningSelector
      a oa:TextQuoteSelector ;
      oa:exact
          "The results from experiments carried out with 45 students indicate that a “magnet-spring” analogy helped beginners to establish the link between the behavior of a probe and its force–distance curve."@en .

  mlann:AnalogyUnderstandAnnotation
      a oa:Annotation, prov:Entity ;
      rdfs:label "Reviewer 1: Bloom Understand coding of activity A2"@en ;
      oa:motivatedBy oa:classifying ;
      oa:hasBody bloom:RevisedUnderstand ;
      oa:hasTarget mlann:AnalogyLearningTarget ;
      dct:description
          "The analogy is intended to help learners explain a relation between representations, which Reviewer 1 classified as Understand."@en ;
      prov:wasAttributedTo mlann:Reviewer1 ;
      prov:wasGeneratedBy mlann:Reviewer1CodingSession ;
      prov:generatedAtTime "2026-08-18T09:12:00+02:00"^^xsd:dateTime ;
