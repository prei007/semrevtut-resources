<http://www.learn-graph.net/nanodidax/studies> {

study:Millet2013_Publication a dct:BibliographicResource ;
  rdfs:label "Millet et al. (2013)"@en ;
  dct:bibliographicCitation "Millet, G., Lécuyer, A., Burkhardt, J. M., Haliyo, S., & Regnier, S. (2013). Haptics and graphic analogies for the understanding of atomic force microscopy. International journal of human-computer studies, 71(5), 608-626." ;
  dct:identifier "https://doi.org/10.1016/j.ijhcs.2012.12.005" .

study:Millet2013_Study a edp:EmpiricalStudy ;
  rdfs:label "Millet2013 study"@en ;
  dct:source study:Millet2013_Publication ;
  edp:hasMethodType meth:SurveyMethod ;
  edp:hasMethodType meth:SelfEvaluation ;
  edp:hasMethodType meth:PerformanceAnalysis ;
  dct:educationLevel edlev:HigherEducation ;
  edp:forProfile "Engineering students no one has prior knowledge of nanoscale physics."@en ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes .

study:Millet2013_System a edp:LearningEnvironment ;
  rdfs:label "Millet2013 system"@en ;
  dct:source study:Millet2013_Study ;
  edp:relatesToTopic topic:AtomicForceMicroscopy ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  edp:hasFeature study:Millet2013_F1, study:Millet2013_F2, study:Millet2013_F3 ;
  edp:hasActivity study:Millet2013_A1, study:Millet2013_A2, study:Millet2013_A3 .

study:Millet2013_F1 a edp:Feature ;
  rdfs:label "Millet2013 F1"@en ;
  edp:hasFeatureType feat:ScanningProbeHaptics, feat:Simulation ;
  dct:description "The experimental set-up used a simulation written in C on a 3.2 GHz Pentium 4 PC coupled to a VIRTUOSE 3D10–20 haptic device from Haption S.A. Haptic control was updated at a rate of 1 kHz."@en .

study:Millet2013_F2 a edp:Feature ;
  rdfs:label "Millet2013 F2"@en ;
  edp:hasFeatureType feat:Millet2013_FeatureType_2_1 ;
  dct:description "The analogy was described, either as a cantilever beam with a tip or as its analogy consisting of a rigid beam, a spring, and a no-mass magnet."@en .

study:Millet2013_F3 a edp:Feature ;
  rdfs:label "Millet2013 F3"@en ;
  edp:hasFeatureType feat:Simulation ;
  dct:description "A non-immersive 3D real-time simulation of the scanning process."@en .

study:Millet2013_A1 a edp:LearningActivity ;
  rdfs:label "Learning activity 1"@en ;
  edp:sequenceOrder "1"^^xsd:integer ;
  edp:usesFeature study:Millet2013_F1 ;
  edp:hasActionType act:Model ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  dct:description "Students work with Haptic interaction for perceiving the effect of the cantilever stiffness"@en ;
  edp:precedes study:Millet2013_A2 .

study:Millet2013_A2 a edp:LearningActivity ;
  rdfs:label "Learning activity 2"@en ;
  edp:sequenceOrder "2"^^xsd:integer ;
  edp:usesFeature study:Millet2013_F2 ;
  edp:hasActionType act:Represent, act:Measure, act:Record ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  dct:description "Students work with Graphic analogy for AFM cantilever: magnet-spring"@en ;
  edp:precedes study:Millet2013_A3 .

study:Millet2013_A3 a edp:LearningActivity ;
  rdfs:label "Learning activity 3"@en ;
  edp:sequenceOrder "3"^^xsd:integer ;
  edp:usesFeature study:Millet2013_F3 ;
  edp:hasActionType act:Inspect, act:Model ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  dct:description "Students work with A non-immersive 3D real-time simulation of the scanning process."@en .

study:Millet2013_1 a mp:Claim, edp:EmpiricalClaim, edp:OutcomeClaim ;
  rdfs:label "Millet2013 1"@en ;
  dct:source study:Millet2013_Study ;
  mp:statement """The system is appreciated by subjects and had an influence on their preferences and subjective comprehension as well as their performance."""@en ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supportedBy study:Millet2013_Data_1 ;
  edp:relatesToActivity study:Millet2013_A1 ;
  edp:relatesToFeature study:Millet2013_F1 ;
  edp:hasTextualBasis [
    a edp:TextSpan ;
    edp:pageNumber "17"^^xsd:integer ;
    edp:exactQuote "The results showed that both parameters studied were appreciated by subjects and had an inﬂuence on their perception and their understanding of the approach-retract"@en
  ] .

study:Millet2013_Data_1 a mp:Data ;
  rdfs:label "Millet2013 data 1"@en ;
  edp:hasMethodType meth:SurveyMethod ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supports study:Millet2013_1 .

study:Millet2013_2 a mp:Claim, edp:EmpiricalClaim, edp:OutcomeClaim ;
  rdfs:label "Millet2013 2"@en ;
  dct:source study:Millet2013_Study ;
  mp:statement "The haptic interface has positive effecs on (problem solving) performance and learning."@en ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supportedBy study:Millet2013_Data_2 ;
  edp:relatesToActivity study:Millet2013_A1, study:Millet2013_A2 ;
  edp:relatesToFeature study:Millet2013_F1, study:Millet2013_F2 ;
  edp:hasTextualBasis [
    a edp:TextSpan ;
    edp:pageNumber "1"^^xsd:integer ;
    edp:exactQuote "Taken together, our results show a positive inﬂuence of using haptic feedback and graphic analogies, especially when students are ﬁrst exposed to the notions"@en
  ] .

study:Millet2013_Data_2 a mp:Data ;
  rdfs:label "Millet2013 data 2"@en ;
  edp:hasMethodType meth:SelfEvaluation ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supports study:Millet2013_2 .

study:Millet2013_3 a mp:Claim, edp:EmpiricalClaim, edp:OutcomeClaim ;
  rdfs:label "Millet2013 3"@en ;
  dct:source study:Millet2013_Study ;
  mp:statement "The spring analogy has positive effecs on (problem solving) performance and learning."@en ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supportedBy study:Millet2013_Data_3 ;
  edp:relatesToActivity study:Millet2013_A2 ;
  edp:relatesToFeature study:Millet2013_F2 ;
  edp:hasTextualBasis [
    a edp:TextSpan ;
    edp:pageNumber "7"^^xsd:integer ;
    edp:exactQuote "Another potential analogy for elasticity was found in Clement (1988) where experts generated analogies with a cantilever beam to solve a problem with springs."@en
  ] .

study:Millet2013_Data_3 a mp:Data ;
  rdfs:label "Millet2013 data 3"@en ;
  edp:hasMethodType meth:PerformanceAnalysis ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supports study:Millet2013_3 .

study:Millet2013_4 a mp:Claim, edp:EmpiricalClaim, edp:OutcomeClaim ;
  rdfs:label "Millet2013 4"@en ;
  dct:source study:Millet2013_Study ;
  mp:statement "The spring analogy and haptic interface increase engagement, measured as time on task."@en ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supportedBy study:Millet2013_Data_4 ;
  edp:relatesToActivity study:Millet2013_A1, study:Millet2013_A2 ;
  edp:relatesToFeature study:Millet2013_F1, study:Millet2013_F2 ;
  edp:hasTextualBasis [
    a edp:TextSpan ;
    edp:pageNumber "14"^^xsd:integer ;
    edp:exactQuote "Label Verbal indicators Cantilever Cantilever, tip, cone Analogy Magnet, magnetic, spring, capillarity Proportionality Proportional, linear spring Adhesion Adhesion, stuck, ﬁxed, locked, attached Dynamics Snap"@en
  ] .

study:Millet2013_Data_4 a mp:Data ;
  rdfs:label "Millet2013 data 4"@en ;
  edp:hasMethodType meth:PerformanceAnalysis ;
  edp:hasOutcomeType outcome:ConceptualNanoOutcomes ;
  mp:supports study:Millet2013_4 .

}
