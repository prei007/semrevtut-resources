@prefix study: <http://www.learn-graph.net/nanodidax/studies/> .
@prefix mlann: <http://www.learn-graph.net/nanodidax/annotations/Millet2013/> .
@prefix bloom: <http://www.learn-graph.net/thesauri/bloom_outcomes/> .
@prefix oa:    <http://www.w3.org/ns/oa#> .
@prefix mp:    <http://purl.org/mp/> .
@prefix bibo:  <http://purl.org/ontology/bibo/> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .


<http://www.learn-graph.net/nanodidax/graphs/Millet2013-annotations> {

  #################################################################
  # Minimal source description
  #################################################################

  study:Millet2013_Publication
      a dct:BibliographicResource ;
      dct:title
          "Haptics and graphic analogies for the understanding of atomic force microscopy"@en ;
      dct:creator "Millet et al." ;
      dct:issued "2013"^^xsd:gYear ;
      dct:identifier <https://doi.org/10.1016/j.ijhcs.2012.12.005> ;
      bibo:doi "10.1016/j.ijhcs.2012.12.005" .


  #################################################################
  # 1. Classification annotation: activity A2
  #################################################################

  mlann:AnalogyUnderstandAnnotation
      a oa:Annotation ;
      rdfs:label "Bloom Understand coding of the magnet-spring analogy activity"@en ;
      oa:motivatedBy oa:classifying ;
      oa:hasBody bloom:RevisedUnderstand ;
      oa:hasTarget mlann:AnalogyLearningTarget ;
      dct:description
          "Reviewer memo: activity A2 uses a familiar magnet-spring representation to help learners explain the relation between AFM probe behavior and its force-distance curve. The code concerns the intended cognitive process, not the experimental tasks used to measure performance."@en .

  mlann:AnalogyLearningTarget
      a oa:SpecificResource ;
      oa:hasSource study:Millet2013_Publication ;
      bibo:pages "608" ;
      oa:hasSelector mlann:AnalogyLearningSelector .

  mlann:AnalogyLearningSelector
      a oa:TextQuoteSelector ;
      oa:exact
          "The results from experiments carried out with 45 students indicate that a “magnet-spring” analogy helped beginners to establish the link between the behavior of a probe and its force–distance curve."@en .


  #################################################################
  # 2. Claim annotation: haptic interaction (activity A1)
  #################################################################

  mlann:HapticStiffnessAnnotation
      a oa:Annotation ;
      rdfs:label "Extraction of the haptic stiffness finding"@en ;
      oa:motivatedBy oa:describing ;
      oa:hasBody mlann:HapticStiffnessClaim ;
      oa:hasTarget mlann:HapticStiffnessTarget .

  mlann:HapticStiffnessClaim
      a mp:Claim ;
      rdfs:label "Haptic feedback supported perception of cantilever stiffness"@en ;
      mp:statement
          "Haptic feedback focused learners on forces and supported their perception of the effect of cantilever stiffness."@en .

  mlann:HapticStiffnessData
      a mp:Data ;
      rdfs:label "Reported haptic stiffness result"@en ;
      dct:source mlann:HapticStiffnessTarget ;
      mp:supports mlann:HapticStiffnessClaim .

  mlann:HapticStiffnessTarget
      a oa:SpecificResource ;
      oa:hasSource study:Millet2013_Publication ;
      bibo:pages "623" ;
      oa:hasSelector mlann:HapticStiffnessSelector .

  mlann:HapticStiffnessSelector
      a oa:TextQuoteSelector ;
      oa:exact
          "By focusing attention on forces, haptic feedback proved thus useful for perceiving the effect of the cantilever stiffness."@en .


  #################################################################
  # 3. Claim annotation: graphic analogy (activity A2)
  #################################################################

  mlann:AnalogyFindingAnnotation
      a oa:Annotation ;
      rdfs:label "Extraction of the magnet-spring analogy finding"@en ;
      oa:motivatedBy oa:describing ;
      oa:hasBody mlann:AnalogyFindingClaim ;
      oa:hasTarget mlann:AnalogyFindingTarget .

  mlann:AnalogyFindingClaim
      a mp:Claim ;
      rdfs:label "The magnet-spring analogy supported initial understanding"@en ;
      mp:statement
          "The magnet-spring analogy supported novices' initial understanding of the AFM approach-retract phenomenon and its force-distance curve."@en .

  mlann:AnalogyFindingData
      a mp:Data ;
      rdfs:label "Reported magnet-spring analogy result"@en ;
      dct:source mlann:AnalogyFindingTarget ;
      mp:supports mlann:AnalogyFindingClaim .

  mlann:AnalogyFindingTarget
      a oa:SpecificResource ;
      oa:hasSource study:Millet2013_Publication ;
      bibo:pages "623" ;
      oa:hasSelector mlann:AnalogyFindingSelector .

  mlann:AnalogyFindingSelector
      a oa:TextQuoteSelector ;
      oa:exact
          "Overall, the data suggests that the magnet-spring analogy could be useful for explaining to people without any prior knowledge the AR phenomenon and the link with its force–distance curve."@en .
}
