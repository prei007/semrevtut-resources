@prefix bloom: <http://www.learn-graph.net/thesauri/bloom_outcomes/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Vocabulary metadata
#################################################################

bloom:BloomCognitiveTaxonomies
    a dctype:Dataset ;
    dct:title "Bloom cognitive taxonomies: original and revised"@en ;
    dct:description
        "A lightweight SKOS representation of the six categories in the original cognitive domain and the six categories in the revised cognitive-process dimension. It is intended for tutorial examples and study coding, not as a replacement for the source publications."@en ;
    dct:created "2026-08-13"^^xsd:date ;
    dct:modified "2026-08-13"^^xsd:date ;
    owl:versionInfo "0.2.0" ;
    dct:hasPart
        bloom:OriginalCognitiveDomain,
        bloom:RevisedCognitiveProcessDimension .


#################################################################
# Concept schemes
#################################################################

bloom:OriginalCognitiveDomain
    a skos:ConceptScheme ;
    dct:title "Bloom's original cognitive domain"@en ;
    dct:issued "1956"^^xsd:gYear ;
    dct:source <https://search.worldcat.org/title/86054529> ;
    dct:bibliographicCitation
        "Bloom, B. S., Engelhart, M. D., Furst, E. J., Hill, W. H., & Krathwohl, D. R. (1956). Taxonomy of educational objectives: The classification of educational goals. Handbook I: Cognitive domain. New York: David McKay."@en ;
    skos:prefLabel "Bloom's original cognitive domain (1956)"@en ;
    skos:altLabel "Original Bloom's taxonomy"@en ;
    skos:definition
        "The six categories used in the 1956 taxonomy to classify educational objectives in the cognitive domain."@en ;
    skos:scopeNote
        "Use these concepts when a source, coding manual, or analysis explicitly follows the original taxonomy. The ordering is represented by an ordered collection; it is not represented with skos:broader or skos:narrower."@en ;
    skos:editorialNote
        "Definitions in this file are concise paraphrases prepared for the tutorial. Consult the source publication for the full categories, subcategories, examples, and discussion."@en ;
    skos:hasTopConcept
        bloom:OriginalKnowledge,
        bloom:OriginalComprehension,
        bloom:OriginalApplication,
        bloom:OriginalAnalysis,
        bloom:OriginalSynthesis,
        bloom:OriginalEvaluation .

bloom:RevisedCognitiveProcessDimension
    a skos:ConceptScheme ;
    dct:title "Revised Bloom taxonomy: cognitive-process dimension"@en ;
    dct:issued "2001"^^xsd:gYear ;
    dct:source <https://www.loc.gov/item/00063423/> ;
    dct:bibliographicCitation
        "Anderson, L. W., & Krathwohl, D. R. (Eds.). (2001). A taxonomy for learning, teaching, and assessing: A revision of Bloom's taxonomy of educational objectives. New York: Longman."@en ;
    skos:prefLabel "Revised Bloom cognitive-process dimension (2001)"@en ;
    skos:altLabel "Revised Bloom's taxonomy"@en ;
    skos:definition
        "The six categories in the cognitive-process dimension of the 2001 revision of Bloom's taxonomy."@en ;
    skos:scopeNote
        "This scheme represents only the cognitive-process dimension. The revised taxonomy also has a separate knowledge dimension, which is outside the scope of this tutorial vocabulary."@en ;
    skos:scopeNote
        "Use a category to classify the intended, enacted, or evidenced cognitive process in context. Do not assign a category solely because a corresponding verb occurs in a learning objective or study report."@en ;
    skos:editorialNote
        "Definitions in this file are concise paraphrases prepared for the tutorial. Consult the source publication for the complete two-dimensional taxonomy, subcategories, examples, and discussion."@en ;
    skos:hasTopConcept
        bloom:RevisedRemember,
        bloom:RevisedUnderstand,
        bloom:RevisedApply,
        bloom:RevisedAnalyze,
        bloom:RevisedEvaluate,
        bloom:RevisedCreate .


#################################################################
# Ordered collections
#################################################################

bloom:OriginalCognitiveDomainOrder
    a skos:OrderedCollection ;
    dct:isPartOf bloom:OriginalCognitiveDomain ;
    skos:prefLabel
        "Original cognitive categories in the order presented by Bloom et al. (1956)"@en ;
    skos:scopeNote
        "The list records the conventional progression from less complex to more complex objectives. Membership in the list does not assert a skos:broader or skos:narrower relation between adjacent categories."@en ;
    skos:memberList (
        bloom:OriginalKnowledge
        bloom:OriginalComprehension
        bloom:OriginalApplication
        bloom:OriginalAnalysis
        bloom:OriginalSynthesis
        bloom:OriginalEvaluation
    ) .

bloom:RevisedCognitiveProcessOrder
    a skos:OrderedCollection ;
    dct:isPartOf bloom:RevisedCognitiveProcessDimension ;
    skos:prefLabel
        "Revised cognitive-process categories in the order presented by Anderson and Krathwohl (2001)"@en ;
    skos:scopeNote
        "The list records the conventional progression from less complex to more complex cognitive processes. Membership in the list does not assert a skos:broader or skos:narrower relation between adjacent categories."@en ;
    skos:memberList (
        bloom:RevisedRemember
        bloom:RevisedUnderstand
        bloom:RevisedApply
        bloom:RevisedAnalyze
        bloom:RevisedEvaluate
        bloom:RevisedCreate
    ) .


#################################################################
# Original cognitive domain (1956)
#################################################################

bloom:OriginalKnowledge
    a skos:Concept ;
    skos:inScheme bloom:OriginalCognitiveDomain ;
    skos:topConceptOf bloom:OriginalCognitiveDomain ;
    skos:notation "O1" ;
    skos:prefLabel "Knowledge"@en ;
    skos:altLabel "Knowledge objective"@en ;
    skos:definition
        "Objectives concerned with remembering previously learned material, from specific facts to theories and structures."@en ;
    skos:closeMatch bloom:RevisedRemember ;
    skos:historyNote
        "The 2001 revision reframed this category as the cognitive process Remember and treated types of knowledge in a separate knowledge dimension."@en .

bloom:OriginalComprehension
    a skos:Concept ;
    skos:inScheme bloom:OriginalCognitiveDomain ;
    skos:topConceptOf bloom:OriginalCognitiveDomain ;
    skos:notation "O2" ;
    skos:prefLabel "Comprehension"@en ;
    skos:altLabel "Comprehension objective"@en ;
    skos:definition
        "Objectives concerned with grasping meaning, including translation, interpretation, and extrapolation."@en ;
    skos:closeMatch bloom:RevisedUnderstand ;
    skos:historyNote
        "The corresponding category in the 2001 revision is Understand."@en .

bloom:OriginalApplication
    a skos:Concept ;
    skos:inScheme bloom:OriginalCognitiveDomain ;
    skos:topConceptOf bloom:OriginalCognitiveDomain ;
    skos:notation "O3" ;
    skos:prefLabel "Application"@en ;
    skos:altLabel "Application objective"@en ;
    skos:definition
        "Objectives concerned with using abstractions, principles, or methods in particular and concrete situations."@en ;
    skos:closeMatch bloom:RevisedApply ;
    skos:historyNote
        "The corresponding category in the 2001 revision is Apply."@en .

bloom:OriginalAnalysis
    a skos:Concept ;
    skos:inScheme bloom:OriginalCognitiveDomain ;
    skos:topConceptOf bloom:OriginalCognitiveDomain ;
    skos:notation "O4" ;
    skos:prefLabel "Analysis"@en ;
    skos:altLabel "Analysis objective"@en ;
    skos:definition
        "Objectives concerned with breaking material into constituent parts and recognizing relations and organizational principles."@en ;
    skos:closeMatch bloom:RevisedAnalyze ;
    skos:historyNote
        "The corresponding category in the 2001 revision is Analyze."@en .

bloom:OriginalSynthesis
    a skos:Concept ;
    skos:inScheme bloom:OriginalCognitiveDomain ;
    skos:topConceptOf bloom:OriginalCognitiveDomain ;
    skos:notation "O5" ;
    skos:prefLabel "Synthesis"@en ;
    skos:altLabel "Synthesis objective"@en ;
    skos:definition
        "Objectives concerned with combining elements and parts to form a whole or produce a new structure."@en ;
    skos:closeMatch bloom:RevisedCreate ;
    skos:historyNote
        "The 2001 revision reframed the corresponding process as Create and placed it after Evaluate in the ordered sequence."@en .

bloom:OriginalEvaluation
    a skos:Concept ;
    skos:inScheme bloom:OriginalCognitiveDomain ;
    skos:topConceptOf bloom:OriginalCognitiveDomain ;
    skos:notation "O6" ;
    skos:prefLabel "Evaluation"@en ;
    skos:altLabel "Evaluation objective"@en ;
    skos:definition
        "Objectives concerned with judging the value of materials or methods for a purpose by applying criteria."@en ;
    skos:closeMatch bloom:RevisedEvaluate ;
    skos:historyNote
        "The 2001 revision reframed the corresponding process as Evaluate and placed it before Create in the ordered sequence."@en .


#################################################################
# Revised cognitive-process dimension (2001)
#################################################################

bloom:RevisedRemember
    a skos:Concept ;
    skos:inScheme bloom:RevisedCognitiveProcessDimension ;
    skos:topConceptOf bloom:RevisedCognitiveProcessDimension ;
    skos:notation "R1" ;
    skos:prefLabel "Remember"@en ;
    skos:altLabel "Remembering"@en ;
    skos:definition
        "Bring relevant knowledge back from long-term memory."@en .

bloom:RevisedUnderstand
    a skos:Concept ;
    skos:inScheme bloom:RevisedCognitiveProcessDimension ;
    skos:topConceptOf bloom:RevisedCognitiveProcessDimension ;
    skos:notation "R2" ;
    skos:prefLabel "Understand"@en ;
    skos:altLabel "Understanding"@en ;
    skos:definition
        "Construct meaning from oral, written, graphical, or other instructional communication."@en .

bloom:RevisedApply
    a skos:Concept ;
    skos:inScheme bloom:RevisedCognitiveProcessDimension ;
    skos:topConceptOf bloom:RevisedCognitiveProcessDimension ;
    skos:notation "R3" ;
    skos:prefLabel "Apply"@en ;
    skos:altLabel "Applying"@en ;
    skos:definition
        "Select and carry out a procedure in a situation."@en .

bloom:RevisedAnalyze
    a skos:Concept ;
    skos:inScheme bloom:RevisedCognitiveProcessDimension ;
    skos:topConceptOf bloom:RevisedCognitiveProcessDimension ;
    skos:notation "R4" ;
    skos:prefLabel "Analyze"@en ;
    skos:prefLabel "Analyse"@en-GB ;
    skos:altLabel "Analyzing"@en ;
    skos:altLabel "Analysing"@en-GB ;
    skos:altLabel "Analysing"@en-GB ;
    skos:definition
        "Separate material into parts and determine how those parts relate to one another and to the whole."@en .

bloom:RevisedEvaluate
    a skos:Concept ;
    skos:inScheme bloom:RevisedCognitiveProcessDimension ;
    skos:topConceptOf bloom:RevisedCognitiveProcessDimension ;
    skos:notation "R5" ;
    skos:prefLabel "Evaluate"@en ;
    skos:altLabel "Evaluating"@en ;
    skos:definition
        "Judge a process or product by applying criteria and standards."@en .

bloom:RevisedCreate
    a skos:Concept ;
    skos:inScheme bloom:RevisedCognitiveProcessDimension ;
    skos:topConceptOf bloom:RevisedCognitiveProcessDimension ;
    skos:notation "R6" ;
    skos:prefLabel "Create"@en ;
    skos:altLabel "Creating"@en ;
    skos:definition
        "Combine or reorganize elements into a coherent new pattern, structure, or product."@en .
