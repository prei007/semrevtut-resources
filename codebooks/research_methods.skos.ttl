@prefix meth: <http://www.learn-graph.net/nanodidax/schemes/methods/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Vocabulary metadata and concept scheme
#################################################################

meth:Methods
    a skos:ConceptScheme ;
    dct:title "Research methods thesaurus"@en ;
    dct:creator "Peter Reimann" ;
    dct:modified "2026-08-14"^^xsd:date ;
    dct:description
        "A lightweight tutorial vocabulary for describing study designs, data-collection methods, data-analysis methods, and evidence-synthesis methods in research syntheses."@en ;
    owl:versionInfo "0.2.0" ;
    skos:prefLabel "Research methods"@en ;
    skos:scopeNote
        "Assign all applicable concepts. Study design, temporal structure, data collection, and analysis are separate dimensions and are not assumed to be mutually exclusive."@en ;
    skos:hasTopConcept
        meth:StudyDesign,
        meth:DataCollectionMethod,
        meth:DataAnalysisMethod,
        meth:ReviewMethod,
        meth:UnspecificMethod .


#################################################################
# Study designs
#################################################################

meth:StudyDesign
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:topConceptOf meth:Methods ;
    skos:prefLabel "Study design"@en ;
    skos:definition
        "The overall arrangement used to answer a research question, including allocation, comparison, timing, and case structure."@en .

meth:QuantitativeMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Quantitative design"@en ;
    skos:broader meth:StudyDesign ;
    skos:scopeNote
        "Use for designs that primarily compare or estimate quantities. Add more specific design concepts whenever they are reported."@en .

meth:QualitativeMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Qualitative design"@en ;
    skos:broader meth:StudyDesign ;
    skos:scopeNote
        "Use for designs that primarily interpret meanings, experiences, practices, cases, or processes. Record the data-collection and analysis methods separately."@en .

meth:MixedMethods
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Mixed-methods design"@en ;
    skos:altLabel "Mixed methods"@en ;
    skos:broader meth:StudyDesign ;
    skos:definition
        "A design that intentionally integrates qualitative and quantitative components in order to answer the research question."@en .

meth:ExperimentalMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Experimental design"@en ;
    skos:broader meth:QuantitativeMethod ;
    skos:definition
        "A design in which researchers manipulate an intervention or condition and compare outcomes between conditions."@en .

meth:RandomizedExperiment
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Randomized experiment"@en ;
    skos:prefLabel "Randomised experiment"@en-GB ;
    skos:altLabel "Randomized study"@en ;
    skos:broader meth:ExperimentalMethod ;
    skos:definition
        "An experiment in which units are assigned to intervention or comparison conditions using a random procedure."@en ;
    skos:scopeNote
        "Code randomization only when random assignment is reported or adequately documented; do not infer it from the presence of comparison groups or inferential statistics."@en .

meth:QuasiExperiment
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Quasi-experimental design"@en ;
    skos:altLabel "Quasi-experiment"@en ;
    skos:broader meth:ExperimentalMethod ;
    skos:definition
        "A design that estimates an intervention effect without random assignment, typically using a comparison group, discontinuity, interrupted time series, or another design-based strategy."@en ;
    skos:scopeNote
        "Do not apply merely because a study has pretest and posttest observations; record the temporal structure separately."@en .

meth:PrePost
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Pretest-posttest design"@en ;
    skos:altLabel "Pre-post design"@en ;
    skos:broader meth:QuantitativeMethod ;
    skos:definition
        "A design in which the same outcome or construct is measured before and after an intervention or exposure."@en ;
    skos:scopeNote
        "This temporal feature can accompany randomized, quasi-experimental, or single-group designs and should be coded independently of allocation."@en .

meth:BetweenGroupsDesign
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Between-groups design"@en ;
    skos:altLabel "Between-subjects design"@en ;
    skos:broader meth:QuantitativeMethod ;
    skos:definition
        "A design that compares outcomes from different groups or conditions rather than repeated conditions within the same units."@en .

meth:CrossSectionalDesign
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Cross-sectional design"@en ;
    skos:broader meth:QuantitativeMethod ;
    skos:definition
        "A design that measures variables for a sample at one time or over a short observation window without planned longitudinal follow-up."@en .

meth:LongitudinalDesign
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Longitudinal design"@en ;
    skos:broader meth:StudyDesign ;
    skos:definition
        "A design that observes the same units, cohorts, or populations at multiple time points to study change over time."@en .

meth:CaseStudyMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Case-study design"@en ;
    skos:altLabel "Case study"@en ;
    skos:broader meth:QualitativeMethod ;
    skos:definition
        "An intensive study of one or more bounded cases in their contexts using one or more sources of evidence."@en .

meth:DesignExperiment
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Design experiment"@en ;
    skos:altLabel "Design-based research"@en ;
    skos:broader meth:StudyDesign ;
    skos:definition
        "An iterative design-oriented study that develops and investigates an intervention in context while refining theoretical and practical knowledge."@en .


#################################################################
# Data-collection and measurement methods
#################################################################

meth:DataCollectionMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:topConceptOf meth:Methods ;
    skos:prefLabel "Data-collection method"@en ;
    skos:definition
        "A procedure or instrument used to elicit, observe, measure, or obtain research data."@en .

meth:SurveyMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Survey method"@en ;
    skos:altLabel "Questionnaire method"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "Collection of standardized self-report, knowledge, attitude, experience, or background responses using a questionnaire or survey instrument."@en ;
    skos:scopeNote
        "The presence of survey items does not by itself determine the overall study design."@en .

meth:InterviewMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Interview method"@en ;
    skos:altLabel "Interview"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "Collection of research data through researcher-participant questioning or conversation."@en .

meth:ClinicalInterview
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Clinical interview"@en ;
    skos:broader meth:InterviewMethod ;
    skos:definition
        "A flexible interview used to probe a participant's reasoning, knowledge, or problem-solving processes."@en .

meth:ObservationMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Observation method"@en ;
    skos:altLabel "Observational data collection"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "Systematic recording of behavior, interaction, events, or settings by an observer or recording system."@en .

meth:DocumentAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Document or artifact collection"@en ;
    skos:altLabel "Artifact collection"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "Collection of documents, designs, products, or other artifacts as research data."@en ;
    skos:scopeNote
        "Use an analysis-method concept as well when the analytic treatment of the artifacts is reported."@en .

meth:PerformanceAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Digital performance data"@en ;
    skos:altLabel "Log-file data"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "Digitally recorded traces of task performance, interaction, success, timing, or system use collected as research data."@en .

meth:ConceptMappingMeasure
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Concept-map measure"@en ;
    skos:altLabel "Concept mapping diagnostic"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "A concept-mapping task used to elicit or measure the organization of a participant's knowledge."@en .

meth:SelfEvaluation
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Self-evaluation measure"@en ;
    skos:altLabel "Self-assessment"@en ;
    skos:broader meth:DataCollectionMethod ;
    skos:definition
        "A measure in which participants evaluate, assess, or rank their own performance, knowledge, attitudes, or experience."@en .


#################################################################
# Data-analysis methods
#################################################################

meth:DataAnalysisMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:topConceptOf meth:Methods ;
    skos:prefLabel "Data-analysis method"@en ;
    skos:definition
        "A procedure used to summarize, compare, model, or interpret research data."@en .

meth:QuantitativeAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Quantitative analysis"@en ;
    skos:broader meth:DataAnalysisMethod .

meth:DescriptiveStatistics
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Descriptive statistics"@en ;
    skos:broader meth:QuantitativeAnalysis ;
    skos:definition
        "Numerical summaries of the observed sample or variables, such as counts, percentages, means, and measures of dispersion."@en .

meth:InferentialStatistics
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Inferential statistical analysis"@en ;
    skos:altLabel "Inferential statistical testing"@en ;
    skos:broader meth:QuantitativeAnalysis ;
    skos:definition
        "Statistical estimation or testing used to draw conclusions beyond direct description of the observed values."@en .

meth:QualitativeAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Qualitative analysis"@en ;
    skos:broader meth:DataAnalysisMethod .

meth:ThematicAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Thematic analysis"@en ;
    skos:broader meth:QualitativeAnalysis ;
    skos:definition
        "Analysis that develops and interprets patterns of meaning or themes across qualitative material."@en .

meth:QualitativeContentAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Qualitative content analysis"@en ;
    skos:broader meth:QualitativeAnalysis ;
    skos:definition
        "Systematic qualitative categorization and interpretation of textual, visual, or artifact content."@en .


#################################################################
# Review and synthesis methods
#################################################################

meth:ReviewMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:topConceptOf meth:Methods ;
    skos:prefLabel "Evidence-synthesis method"@en ;
    skos:altLabel "Research review method"@en .

meth:LitReview
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Literature review"@en ;
    skos:broader meth:ReviewMethod .

meth:SystematicReview
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Systematic review"@en ;
    skos:broader meth:ReviewMethod .

meth:MetaAnalysis
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Meta-analysis"@en ;
    skos:broader meth:ReviewMethod .

meth:SynthesisMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:prefLabel "Research synthesis"@en ;
    skos:broader meth:ReviewMethod .


#################################################################
# Missing or unspecific reporting
#################################################################

meth:UnspecificMethod
    a skos:Concept ;
    skos:inScheme meth:Methods ;
    skos:topConceptOf meth:Methods ;
    skos:prefLabel "Unspecified method"@en ;
    skos:definition
        "The report indicates that a method was used but does not provide enough information to assign a more specific method concept."@en ;
    skos:scopeNote
        "Do not use this concept for not applicable or for a method that was not used; represent those states separately in the coding form."@en .
