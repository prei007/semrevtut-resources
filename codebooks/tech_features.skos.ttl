### Technology features

@prefix : <http://www.learn-graph.net/nanodidax/schemes/features/> .
@prefix feat: <http://www.learn-graph.net/nanodidax/schemes/features/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Concept scheme
#################################################################

feat:Features a skos:ConceptScheme ;
  dct:title "Technology feature types"@en ;
  dct:creator "Peter Reimann" ;
  dct:modified "2026-08-14"^^xsd:date ;
  owl:versionInfo "0.1.0" ;
  skos:prefLabel "Feature types"@en .

#################################################################
# Top-level / higher-level concepts
#################################################################

feat:LearningSupportFeature a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:narrower feat:KnowledgeTech ,
                 feat:Measurement ,
                 feat:SensingAndRecording ;
  skos:prefLabel "Learning support features"@en .

feat:DesignMethodFeature a skos:Concept ;
  skos:example "Using an AI tool to create content."@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Design method feature"@en ;
  skos:scopeNote "Features for the designer rather than the learner."@en .

feat:AssessmentMethodFeature a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Assessment method feature"@en ;
  skos:altLabel "Feedback feature"@en ;
  skos:scopeNote "Features for feedback, formative and summative assesment."@en .

feat:TeachingPlatform a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:narrower feat:AppBasedPlatform ,
                 feat:WebBasedPlatform ;
  skos:prefLabel "Teaching platform"@en .

feat:KnowledgeTech a skos:Concept ;
  skos:broader feat:LearningSupportFeatures ;
  skos:broaderTransitive feat:LearningSupportFeatures ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Knowledge technologies"@en .

feat:eLearning a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "E-learning"@en .

feat:eResearch a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "e-Research"@en .

feat:GamesAndSimulations a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Games and simulations"@en ;
  skos:related feat:ComputerModel .

feat:ComputerModel a skos:Concept ;
  skos:altLabel "Computer simulation model"@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Computer model"@en .

feat:SimulationShell a skos:Concept ;
  skos:broader feat:GamesAndSimulations ;
  skos:broaderTransitive feat:GamesAndSimulations ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Simulation shell"@en .

feat:ImmersiveTech a skos:Concept ;
  skos:altLabel "XR"@en ;
  skos:broader feat:KnowledgeTech ;
  skos:broaderTransitive feat:KnowledgeTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Immersive technologies"@en .

feat:MobileLearning a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Mobile technology"@en .


#################################################################
# Assessment and feedback
#################################################################

:QuizEngine a skos:Concept ;
  skos:broader feat:AssessmentMethodFeature ;
  skos:broaderTransitive feat:AssessmentMethodFeature ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Quiz engine"@en ;
  skos:definition "A software component that allows for the authoring and display of quizes and multiple choice questions"@en .

#################################################################
# Teaching platforms
#################################################################

feat:WebBasedPlatform a skos:Concept ;
  skos:broader feat:TeachingPlatform ;
  skos:broaderTransitive feat:TeachingPlatform ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Web-based platform"@en .

feat:AppBasedPlatform a skos:Concept ;
  skos:broader feat:TeachingPlatform ;
  skos:broaderTransitive feat:TeachingPlatform ;
  skos:inScheme feat:Features ;
  skos:prefLabel "App-based platform"@en .

#################################################################
# Learning support: measurement, sensing, recording
#################################################################

feat:Measurement a skos:Concept ;
  skos:broader feat:LearningSupportFeature ;
  skos:broaderTransitive feat:LearningSupportFeatures ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Measurement"@en .

feat:SensingAndRecording a skos:Concept ;
  skos:broader feat:LearningSupportFeature ;
  skos:broaderTransitive feat:LearningSupportFeatures ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Sensing and recording"@en .

feat:DigitalMicroscope a skos:Concept ;
  skos:broader feat:Measurement ;
  skos:broaderTransitive feat:Measurement ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Digital microscope"@en .

feat:RealExperiment a skos:Concept ;
  skos:broader feat:Measurement ;
  skos:broaderTransitive feat:Measurement ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Real experiment"@en .

feat:DataLogging a skos:Concept ;
  skos:broader feat:SensingAndRecording ;
  skos:broaderTransitive feat:SensingAndRecording ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Data logging"@en .

feat:GPS a skos:Concept ;
  skos:broader feat:SensingAndRecording ;
  skos:broaderTransitive feat:SensingAndRecording ;
  skos:inScheme feat:Features ;
  skos:prefLabel "GPS"@en .

feat:QR a skos:Concept ;
  skos:altLabel "Quick response code"@en ;
  skos:broader feat:SensingAndRecording ;
  skos:broaderTransitive feat:SensingAndRecording ;
  skos:inScheme feat:Features ;
  skos:prefLabel "QR code"@en .


#################################################################
# Knowledge technologies
#################################################################

feat:ConceptMapping a skos:Concept ;
  skos:broader feat:KnowledgeTech ;
  skos:broaderTransitive feat:KnowledgeTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Concept mapping"@en .

feat:DataVisualization a skos:Concept ;
  skos:broader feat:KnowledgeTech ;
  skos:broaderTransitive feat:KnowledgeTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Data visualisation"@en .

feat:ImmersiveTech a skos:Concept ;
  skos:altLabel "XR"@en ;
  skos:broader feat:KnowledgeTech ;
  skos:broaderTransitive feat:KnowledgeTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Immersive technologies"@en .

#################################################################
# Immersive tech and virtual worlds
#################################################################

feat:VirtualReality a skos:Concept ;
  skos:altLabel "VR"@en ;
  skos:broader feat:ImmersiveTech ;
  skos:broaderTransitive feat:ImmersiveTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Virtual reality"@en .

feat:AugmentedReality a skos:Concept ;
  skos:altLabel "AR"@en ;
  skos:broader feat:ImmersiveTech ;
  skos:broaderTransitive feat:ImmersiveTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Augmented reality"@en .

feat:MixedReality a skos:Concept ;
  skos:altLabel "MR"@en ;
  skos:broader feat:ImmersiveTech ;
  skos:broaderTransitive feat:ImmersiveTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Mixed reality"@en .

feat:VirtualWorld a skos:Concept ;
  skos:broader feat:ImmersiveTech ;
  skos:broaderTransitive feat:ImmersiveTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Virtual world"@en .

feat:VirtualFieldTrip a skos:Concept ;
  skos:broader feat:ImmersiveTech ;
  skos:broaderTransitive feat:ImmersiveTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Virtual field trip"@en .


feat:VirtualLaboratory a skos:Concept ;
  skos:broader feat:VirtualWorld ;
  skos:broaderTransitive feat:VirtualWorld ;
  skos:closeMatch feat:VirtualExperimentation ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Virtual laboratory"@en .

feat:2DVirtualLaboratory a skos:Concept ;
  skos:altLabel "Two-dimension virtual reality"@en ;
  skos:broader feat:VirtualLaboratory ;
  skos:broaderTransitive feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "2D virtual reality"@en .

feat:VirtualInstrument a skos:Concept ;
  skos:altLabel "Virtual tool"@en ;
  skos:broader feat:VirtualLaboratory ;
  skos:broaderTransitive feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Virtual instrument"@en .

feat:2DVirtualInstrument a skos:Concept ;
  skos:altLabel "2D virtual tool"@en ;
  skos:broader feat:VirtualInstrument ;
  skos:broaderTransitive feat:VirtualInstrument ;
  skos:inScheme feat:Features ;
  skos:prefLabel "2D virtual instrument"@en .

feat:MultiSensoryMicroscopeView a skos:Concept ;
  skos:broader feat:VirtualLaboratory ;
  skos:broaderTransitive feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Multi-sensory microscope view"@en .

feat:VirtualExperimentation a skos:Concept ;
  skos:broader feat:VirtualWorld ;
  skos:broaderTransitive feat:VirtualWorld ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Virtual experimentation"@en .

feat:EExperiment a skos:Concept ;
  skos:altLabel "Remote experiment"@en ,
                "Remote laboratory"@en ;
  skos:broader feat:VirtualExperimentation ;
  skos:broaderTransitive feat:VirtualExperimentation ;
  skos:closeMatch feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "E-experiment"@en .

feat:GestureBasedImmersionPlatform a skos:Concept ;
  skos:broader feat:MixedReality ;
  skos:broaderTransitive feat:MixedReality ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Gesture-based immersion platform"@en .

#################################################################
# Games, simulations, modelling
#################################################################

feat:Game a skos:Concept ;
  skos:altLabel "Serious game"@en ;
  skos:broader feat:GamesAndSimulations ;
  skos:broaderTransitive feat:GamesAndSimulations ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Educational game"@en ;
  skos:related feat:MobileGame ;
  skos:scopeNote "Refers to computer or digital games, not to board games, etc."@en .

feat:VideoGame a skos:Concept ;
  skos:broader feat:Game ;
  skos:broaderTransitive feat:Game ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Video game"@en .

feat:RolePlay a skos:Concept ;
  skos:broader feat:Game ;
  skos:broaderTransitive feat:Game ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Role play"@en .

feat:Simulation a skos:Concept ;
  skos:altLabel "Computer model"@en ;
  skos:broader feat:GamesAndSimulations ;
  skos:broaderTransitive feat:GamesAndSimulations ;
  skos:inScheme feat:Features ;
  skos:note "The preferred term is ComputerModel. The two are practically synonyms; simulation is more broad because it includes simulations that do not rely on a computer (e.g., physical flight simulators)."@en ;
  skos:prefLabel "Computer simulation"@en .

feat:ABM a skos:Concept ;
  skos:altLabel "Individual model"@en ;
  skos:broader feat:ComputerModel ;
  skos:broaderTransitive feat:ComputerModel ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Agent-based model"@en ;
  skos:related feat:SimulationShell .

feat:NetLogo a skos:Concept ;
  skos:broader feat:SimulationShell ;
  skos:broaderTransitive feat:SimulationShell ;
  skos:inScheme feat:Features ;
  skos:prefLabel "NetLogo"@en ;
  skos:related feat:ABM .

feat:NetLogoModel a skos:Concept ;
  skos:broader feat:ABM ;
  skos:broaderTransitive feat:ABM ;
  skos:inScheme feat:Features ;
  skos:prefLabel "NetLogo model"@en .

feat:ScratchModel a skos:Concept ;
  skos:broader feat:ComputerModel ;
  skos:broaderTransitive feat:ComputerModel ;
  skos:definition "A program authored with the Scratch software."@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Scratch program"@en .

feat:ScienceBasedModel a skos:Concept ;
  skos:definition "Models that are explicitly grounded in knowledge from scientific theories and established models."@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Science-based model"@en ;
  skos:related feat:DataBasedModel .

feat:DataBasedModel a skos:Concept ;
  skos:definition "Models that are grounded in data such as measurement or observation."@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Data-based model"@en ;
  skos:related feat:ScienceBasedModel .

feat:DemonstrationModel a skos:Concept ;
  skos:example "Schelling's segregation model; many predator–prey models."@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Demonstration model"@en ;
  skos:scopeNote "Models demonstrating an effect or process in an idealized form."@en .

#################################################################
# e-Learning / video / AI etc.
#################################################################

feat:VideoAnnotation a skos:Concept ;
  skos:broader feat:eLearning ;
  skos:broaderTransitive feat:eLearning ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Video annotation"@en .

feat:AI a skos:Concept ;
  skos:altLabel "AI"@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Artificial intelligence"@en .

feat:CAI a skos:Concept ;
  skos:altLabel "Computer-based instruction"@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Computer-aided instruction"@en .

feat:CBA a skos:Concept ;
  skos:altLabel "Computer-based testing"@en ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Computer-based assessment"@en .

#################################################################
# e-Research related
#################################################################

feat:DataScienceTool a skos:Concept ;
  skos:broader feat:eResearch ;
  skos:broaderTransitive feat:eResearch ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Data science tool"@en .

feat:GIS a skos:Concept ;
  skos:broader feat:eResearch ;
  skos:broaderTransitive feat:eResearch ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Geographic information system"@en .

feat:ModelingLanguage a skos:Concept ;
  skos:broader feat:eResearch ;
  skos:broaderTransitive feat:eResearch ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Modelling language"@en .

#################################################################
# Mobile learning
#################################################################

feat:MobileGame a skos:Concept ;
  skos:broader feat:MobileLearning ;
  skos:broaderTransitive feat:MobileLearning ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Mobile game"@en ;
  skos:related feat:Game ,
                feat:MixedReality .

#################################################################
# Multimedia
#################################################################

:MultimediaFeature a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Multimedia feature"@en ;
  skos:related feat:MixedReality .

:TextToVoice a skos:Concept ;
    skos:inScheme feat:Features ;
    skos:prefLabel "Text to voice"@en ;
    skos:broader :MultimediaFeature ;
    skos:broaderTransitive :MultimediaFeature .

feat:DocumentaryVideo
    a skos:Concept ;
    skos:inScheme feat:Features ;
    skos:prefLabel "Documentary video"@en ;
    skos:broader feat:MultimediaFeature .

#################################################################
# Design method features
#################################################################

feat:ContentCustomization a skos:Concept ;
  skos:broader feat:DesignMethodFeature ;
  skos:broaderTransitive feat:DesignMethodFeature ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Content customization"@en .

feat:VideoContentTransformation a skos:Concept ;
  skos:broader feat:DesignMethodFeature ;
  skos:broaderTransitive feat:DesignMethodFeature ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Automatic video to content transformation"@en .


#################################################################
# Nano-typical virtual lab & simulation features
#################################################################

feat:AFMSimulator a skos:Concept ;
  skos:broader feat:VirtualLaboratory ;
  skos:broaderTransitive feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "AFM simulator"@en ;
  skos:altLabel "Atomic force microscope simulator"@en ;
  skos:definition "Interactive virtual module that simulates an atomic force microscope, including tip–sample interactions and image acquisition."@en ;
  skos:related feat:DigitalMicroscope ,
               feat:ComputerModel .

feat:STMSimulator a skos:Concept ;
  skos:broader feat:VirtualLaboratory ;
  skos:broaderTransitive feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "STM simulator"@en ;
  skos:altLabel "Scanning tunnelling microscope simulator"@en ;
  skos:definition "Interactive virtual module that simulates a scanning tunnelling microscope, allowing learners to explore tunnelling current and surface imaging."@en ;
  skos:related feat:DigitalMicroscope ,
               feat:ComputerModel .

feat:NanoSelfAssemblySimulator a skos:Concept ;
  skos:broader feat:ComputerModel ;
  skos:broaderTransitive feat:ComputerModel ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano self-assembly simulator"@en ;
  skos:definition "A computer model or simulation that visualises and animates self-assembly of nano-scale building blocks under different conditions."@en ;
  skos:related feat:Simulation ,
               feat:VirtualExperimentation .

feat:NanoQuantumDotLab a skos:Concept ;
  skos:broader feat:VirtualLaboratory ;
  skos:broaderTransitive feat:VirtualLaboratory ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Quantum dot virtual lab"@en ;
  skos:definition "Virtual laboratory environment for exploring quantum dots, band gaps, and size-dependent optical properties."@en ;
  skos:related feat:DataVisualization ,
               feat:Simulation .

feat:NanoCleanroomVR a skos:Concept ;
  skos:broader feat:VirtualWorld ;
  skos:broaderTransitive feat:VirtualWorld ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano cleanroom VR"@en ;
  skos:altLabel "Virtual cleanroom"@en ;
  skos:definition "Immersive virtual environment that simulates a nano fabrication cleanroom, equipment, and procedures."@en ;
  skos:related feat:VirtualReality .

#################################################################
# Measurement & force–distance / tracking tools
#################################################################

feat:NanoForceGraphTool a skos:Concept ;
  skos:broader feat:Measurement ;
  skos:broaderTransitive feat:Measurement ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano force–distance graph tool"@en ;
  skos:definition "Tool that acquires and displays force–distance or force–time curves at the nano-scale, often coupled with interactive analysis or VR visualisation."@en ;
  skos:related feat:DataLogging ,
               feat:DataVisualization .

feat:NanoParticleSizeAnalyzer a skos:Concept ;
  skos:broader feat:Measurement ;
  skos:broaderTransitive feat:Measurement ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nanoparticle size analyser"@en ;
  skos:definition "Instrument or software for determining nanoparticle size distributions (e.g., DLS, image-based analysis) with educational interfaces."@en ;
  skos:related feat:DigitalMicroscope ,
               feat:DataScienceTool .

feat:NanoRemoteMicroscopyPortal a skos:Concept ;
  skos:broader feat:VirtualExperimentation ;
  skos:broaderTransitive feat:VirtualExperimentation ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Remote nano-microscopy portal"@en ;
  skos:altLabel "Remote nano imaging interface"@en ;
  skos:definition "Web-based or virtual interface for remotely controlling nano-scale imaging instruments (e.g., AFM, SEM, TEM) for educational use."@en ;
  skos:related feat:EExperiment ,
               feat:DigitalMicroscope .

#################################################################
# Visualisation & multi-scale linking tools
#################################################################

feat:NanoBandStructureVisualizer a skos:Concept ;
  skos:broader feat:DataVisualization ;
  skos:broaderTransitive feat:DataVisualization ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano band structure visualiser"@en ;
  skos:definition "Interactive visualisation tool for exploring electronic band structures, density of states, and related nano-scale properties."@en ;
  skos:related feat:ScienceBasedModel .

feat:NanoMultiScaleLinker a skos:Concept ;
  skos:broader feat:KnowledgeTech ;
  skos:broaderTransitive feat:KnowledgeTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano multi-scale representation linker"@en ;
  skos:definition "Tool that coordinates nano, micro, and macro representations (e.g., micrographs, schematic diagrams, graphs) within a unified interface."@en ;
  skos:related feat:DataVisualization ,
               feat:ConceptMapping .

feat:NanoProcessAnimationTool a skos:Concept ;
  skos:broader feat:DataVisualization ;
  skos:broaderTransitive feat:DataVisualization ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano process animation tool"@en ;
  skos:definition "Software that animates nano-scale processes such as diffusion, self-assembly, or tunnelling with controllable parameters."@en ;
  skos:related feat:Simulation ,
               feat:VirtualLaboratory .

#################################################################
# Databases, dashboards, and e-research
#################################################################

feat:NanoMaterialDatabase a skos:Concept ;
  skos:broader feat:eResearch ;
  skos:broaderTransitive feat:eResearch ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nanomaterial database"@en ;
  skos:definition "Online database of nano materials, structures, and properties used for inquiry and design tasks in nano education."@en ;
  skos:related feat:DataScienceTool ,
               feat:KnowledgeTech .

feat:NanoToxicologyDashboard a skos:Concept ;
  skos:broader feat:eResearch ;
  skos:broaderTransitive feat:eResearch ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Nano toxicology dashboard"@en ;
  skos:definition "Dashboard-style interface that aggregates data on nano material toxicity, exposure, and regulatory thresholds for educational analysis."@en ;
  skos:related feat:DataVisualization ,
               feat:GIS .

#################################################################
# Haptics and multisensory nano tools
#################################################################

feat:ScanningProbeHaptics a skos:Concept ;
  skos:broader feat:ImmersiveTech ;
  skos:broaderTransitive feat:ImmersiveTech ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Scanning probe haptic interface"@en ;
  skos:definition "Haptic device or VR interface that renders nano-scale forces (e.g., AFM tip–sample interactions) as felt resistance or vibration."@en ;
  skos:related feat:MultiSensoryMicroscopeView ,
               feat:VirtualReality .

#################################################################
# AI: classic and generative
#################################################################

feat:ArtificialIntelligence a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Use of AI"@en ;
  skos:definition "Broad category for any use of AI technology"@en .

feat:AIbasedDataExtraction a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Using AI for data extraction"@en ;
  skos:definition "Students can upload data files and an AI can extract the data for exploration."@en ;
  skos:broader feat:ArtificialIntelligence .

feat:ChatBot a skos:Concept ;
  skos:inScheme feat:Features ;
  skos:prefLabel "AI chatbot"@en ;
  skos:definition "Students use an AI chatbot for specific purposes, such as analysing data, creating visualisations."@en ;
  skos:broader feat:ArtificialIntelligence .


#################################################################
# Additive three-dimensional refactoring
#################################################################

feat:Features skos:hasTopConcept feat:TechnologyForm, feat:InteractionPattern, feat:CognitiveRole .

feat:hasTechnologyForm a rdf:Property ;
  rdfs:label "has technology form"@en ;
  rdfs:comment "Relates a technology feature to the kind of artefact, environment, or tool it provides."@en ;
  rdfs:range feat:TechnologyForm .

feat:hasInteractionPattern a rdf:Property ;
  rdfs:label "has interaction pattern"@en ;
  rdfs:comment "Relates a technology feature to characteristic learner actions or use patterns it supports."@en ;
  rdfs:range feat:InteractionPattern .

feat:hasCognitiveRole a rdf:Property ;
  rdfs:label "has cognitive role"@en ;
  rdfs:comment "Relates a technology feature to the transformation it supports in perception, action, reasoning, coordination, or learning."@en ;
  rdfs:range feat:CognitiveRole .

#################################################################
# Technology forms
#################################################################

feat:TechnologyForm a skos:Concept ;
  skos:topConceptOf feat:Features ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Technology form"@en ;
  skos:definition "The kind of technological artefact, environment, interface, or tool provided to learners or teachers."@en .


feat:ImmersiveEnvironment a skos:Concept ;
  skos:broader feat:TechnologyForm ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Immersive environment"@en .

feat:AugmentedEnvironment a skos:Concept ;
  skos:broader feat:TechnologyForm ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Augmented environment"@en .

feat:MixedRealityEnvironment a skos:Concept ;
  skos:broader feat:TechnologyForm ;
  skos:inScheme feat:Features ;
  skos:prefLabel "Mixed reality environment"@en .

feat:VirtualLaboratorySystem a skos:Concept ;
  skos:broader feat:TechnologyForm ;
  skos:inScheme feat:Features ;
